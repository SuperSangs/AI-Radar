# Copy this file to .env.local and fill in only the services you use.
# Never commit .env.local or paste real API keys into source files.

# Server
AI_RADAR_HOST=127.0.0.1
AI_RADAR_PORT=8765
AI_RADAR_REFRESH_MINUTES=30
# AI_RADAR_DB=/absolute/path/to/ai-radar.db

# Optional GitHub API token. Anonymous requests work with a lower rate limit.
# GITHUB_TOKEN=github_pat_...

# X API. The default plan is one Recent Search request budget per 24 hours,
# up to 30 tweet resources in total (three pages of 10).
# X_BEARER_TOKEN=...
# X_MAX_RESULTS=30
# X_MAX_CALLS_PER_DAY=1
# X_MIN_INTERVAL_MINUTES=1440
# X_HTTPS_PROXY=http://127.0.0.1:7890

# Optional translation through Alibaba Cloud DashScope OpenAI-compatible API.
# DASHSCOPE_API_KEY=sk-...
# TRANSLATION_MODEL=deepseek-v4-flash-0731
# DASHSCOPE_CHAT_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
