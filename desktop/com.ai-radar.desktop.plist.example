<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ai-radar.desktop</string>
    <key>ProgramArguments</key>
    <array>
        <!-- Replace with the absolute path to AIRadarDesktop.app executable. -->
        <string>__APP_EXECUTABLE__</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>/tmp/ai-radar-desktop.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/ai-radar-desktop.err.log</string>
</dict>
</plist>
